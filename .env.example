# Configuración de S3 conservada; el tablero usa localStorage y no la necesita.

# Credenciales de servidor: no exponer en el navegador
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# Opciones de la aplicación
S3_ALLOWED_ORIGINS=http://localhost:3000
PERFORMANCE_LOGS=true
